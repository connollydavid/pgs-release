# Project-local environment. Copy to .env and adjust; source with:
#   set -a && . ./.env && set +a
# Never commit real keys. Rotate after scans (operator ruling).

# The fairy review pipeline (scripts/fairy/run-local.sh) reads:
#   ZAI_API_KEY      z.ai native API key (with MODEL=zai:glm-5.2)
#   OPENAI_API_KEY   ollama API key (openai-compatible endpoint)
#   OPENAI_BASE_URL  https://ollama.com/v1  (NOT api.ollama.com; its 301 breaks POST)
#   MODEL            the reviewer model tag, e.g. zai:glm-5.2
#ZAI_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://ollama.com/v1
#MODEL=zai:glm-5.2

# Tool builds (host-lint, host-lifecycle) put binaries under their
# target/release dirs; add them to PATH to run the tools bare:
#   (cd tools/host-lint && cargo build --release)
#   (cd tools/host-lifecycle && cargo build --release)
#PATH=<project-root>/tools/host-lint/target/release:<project-root>/tools/host-lifecycle/target/release:/usr/local/bin:/usr/bin:/bin
