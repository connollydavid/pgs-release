# Project-local tool paths. Copy to .env and adjust.
# Source with: set -a && . ./.env && set +a
# Build the tools first: (cd tools/host-lint && cargo build --release) && (cd tools/host-lifecycle && cargo build --release)
PATH=<project-root>/tools/host-lint/target/release:<project-root>/tools/host-lifecycle/target/release:/usr/local/bin:/usr/bin:/bin
